# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Paths are deliberately unanchored: this is a workspace, so the same artefacts
# appear at the root and again inside every app under apps/.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project: app data (SQLite database, uploaded photos, Markdown copy of the
# collection) and Playwright output, at the root and inside every app
data/
test-results/
playwright-report/
blob-report/
# what scripts/release-candidate.sh packages
release/

# editors
.vscode/
.idea/

.claude/settings.local.json

# Secrets: ignore every .env variant, but keep the documented template.
.env*
!.env.example
