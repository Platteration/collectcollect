# --- Card identification (required for photo identification) ---
# Anthropic API key. Without it you can still add cards by hand.
ANTHROPIC_API_KEY=
# Optional: vision model used for identification (default: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# --- Price sources (all optional) ---
# PriceCharting paid API token. The only source of graded (PSA/BGS/CGC/SGC) prices;
# covers Pokémon, Yu-Gi-Oh!, Magic and sports cards. https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=
# Pokémon TCG API key (free) for higher rate limits. https://dev.pokemontcg.io
POKEMONTCG_API_KEY=

# --- Price history ---
# Re-price cards whose latest snapshot is older than this many hours (checked hourly). 0 disables.
# AUTO_REFRESH_HOURS=24

# Alerts are configured in the app under Settings, including an optional
# webhook URL that each alert is POSTed to as JSON.

# --- Access (optional) ---
# Set a password to require a login before anything is reachable.
# APP_PASSWORD=
# Optional separate signing secret. Without it a random key is generated on
# first login and kept in the data directory (session-secret). Either way the
# password is mixed into the key, so changing the password ends every existing
# session.
# APP_SECRET=
# Host names this instance answers to, comma-separated (`*` disables the check).
# The default accepts localhost, any IP address, single-label machine names and
# .local/.lan/.internal names; set this if you reach the app by a domain name,
# for example through a reverse proxy.
# ALLOWED_HOSTS=cards.example.com
# Set this when a reverse proxy in front of the app adds X-Forwarded-For and
# X-Forwarded-Proto, so the login rate limiter can tell one caller from another
# and the session cookie knows the connection was secure. Both headers are read
# from the RIGHT: nginx and Caddy both append rather than rewrite, so the
# rightmost entry is what the nearest proxy saw and everything left of it is
# whatever the client typed. Without this the headers are ignored entirely and
# nobody is locked out on anybody else's behalf.
# TRUST_PROXY=1
# How many proxies of your own are in front of the app, if more than one; the
# client is that many entries from the right of the chain. Defaults to 1 when
# TRUST_PROXY is set, and setting this alone is enough — it turns proxy trust on
# for the forwarded headers just as TRUST_PROXY does.
# TRUSTED_PROXY_HOPS=1
# Whether the session cookie is marked Secure. By default it follows the scheme
# of the request, which is plain HTTP when a reverse proxy terminates TLS; set
# this to 1 when the app is only ever reached over https (or 0 to force it off).
# COOKIE_SECURE=1

# --- Memory ---
# Request bodies are buffered whole (a restore, a photo upload), up to 64 MB
# each, and the limit is per request rather than across them: give the app
# roughly (uploads in flight x 2 x 64 MB) of headroom above its idle ~200 MB.
# compose.yaml sets a 2 GB limit, which covers a handful at once.

# --- Storage ---
# Directory for the SQLite database and uploaded photos (default: ./data)
# DATA_DIR=./data
