# --- Card identification (required for photo identification) ---
# Anthropic API key. Without it you can still add cards by hand.
ANTHROPIC_API_KEY=
# Optional: vision model used for identification (default: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# --- Price sources (all optional) ---
# PriceCharting paid API token. The only source of graded (PSA/BGS/CGC/SGC) prices;
# covers Pokémon, Yu-Gi-Oh!, Magic and sports cards. https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=
# Pokémon TCG API key (free) for higher rate limits. https://dev.pokemontcg.io
POKEMONTCG_API_KEY=

# --- Price history ---
# Re-price cards whose latest snapshot is older than this many hours (checked hourly). 0 disables.
# AUTO_REFRESH_HOURS=24

# Alerts are configured in the app under Settings, including an optional
# webhook URL that each alert is POSTed to as JSON.

# --- Access (optional) ---
# Set a password to require a login before anything is reachable.
# APP_PASSWORD=
# Optional separate signing secret. Without it a random key is generated on
# first login and kept in the data directory (session-secret), mixed with the
# password so that changing the password still ends existing sessions.
# APP_SECRET=
# Host names this instance answers to, comma-separated (`*` disables the check).
# The default accepts localhost, any IP address, single-label machine names and
# .local/.lan/.internal names; set this if you reach the app by a domain name,
# for example through a reverse proxy.
# ALLOWED_HOSTS=cards.example.com
# Set this only when a reverse proxy in front of the app rewrites
# X-Forwarded-For. Without it the login rate limiter ignores that header,
# because anyone can set it to a fresh value on every guess.
# TRUST_PROXY=1
# Whether the session cookie is marked Secure. By default it follows the scheme
# of the request, which is plain HTTP when a reverse proxy terminates TLS; set
# this to 1 when the app is only ever reached over https (or 0 to force it off).
# COOKIE_SECURE=1

# --- Storage ---
# Directory for the SQLite database and uploaded photos (default: ./data)
# DATA_DIR=./data
