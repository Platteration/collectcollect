# ===========================================================================
# The card app (apps/cards)
# ===========================================================================

# --- Card identification (required for photo identification) ---
# Anthropic API key. Without it you can still add cards by hand. An OAuth
# token from `ant auth login` works in its place as ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# Optional: vision model used for identification (default: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# --- Price sources (all optional) ---
# PriceCharting paid API token. The only source of graded (PSA/BGS/CGC/SGC) prices;
# covers Pokémon, Yu-Gi-Oh!, Magic and sports cards. https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=
# Pokémon TCG API key (free) for higher rate limits. https://dev.pokemontcg.io
POKEMONTCG_API_KEY=

# --- Grading reports (optional) ---
# PSA Public API token, from your PSA account at psacard.com/publicapi. Fills a
# graded card's grade, label, population and PSA's own scans from its cert
# number (about a hundred lookups a day). PSA approves accounts for its API, so
# a new token may be refused until then; generating it accepts PSA's API
# agreement. The other grading companies are links the app opens for you.
PSA_API_TOKEN=

# --- Price history ---
# Re-price cards whose latest snapshot is older than this many hours (checked
# hourly). 0 disables. Read once at start, so a change needs a restart.
# AUTO_REFRESH_HOURS=24

# Alerts are configured in the app under Settings, including an optional
# webhook URL that each alert is POSTed to as JSON.

# --- Access (optional) ---
# Set a password to require a login before anything is reachable.
# APP_PASSWORD=
# Optional separate signing secret. Without one, a random key is made on first
# login and kept in DATA_DIR/session-secret; set this to use a key of your own.
# APP_SECRET=
# Believe X-Forwarded-For when counting login attempts and rate limits. Only
# set this when a reverse proxy in front of the app sets that header; without
# one, anyone could send it. Read by both apps.
# TRUST_PROXY=1
# Which host names the app answers to. The default accepts localhost, any IP
# address, single-label machine names and .local/.lan/.internal/.home.arpa
# names — none of which a public DNS record can impersonate. Set this
# (comma-separated) if you reach the app by a domain name, for example through
# a reverse proxy, and have the proxy pass the original Host header through
# (nginx: proxy_set_header Host $host; Caddy does by default). `*` disables
# the check. Read by both apps.
# ALLOWED_HOSTS=cards.example.com

# --- Storage ---
# Directory for the SQLite database, uploaded photos and the Markdown copy
# of the collection (default: ./data, resolved from apps/cards). Ignored under
# Docker Compose, where the data directory is always the /data volume.
# DATA_DIR=./data
# The database file itself, when it should live somewhere other than DATA_DIR.
# DATABASE_FILE=./data/collectcollect.db
# Every card is also written as a Markdown file under DATA_DIR/collection so the
# collection outlives the app. Set to "off" for a read-only data volume.
# MARKDOWN_MIRROR=on

# ===========================================================================
# The CS2 skins app (apps/skins)
# ===========================================================================
# Its own variables throughout, so both apps can run side by side from one
# shell without either one pointing at the other's collection.

# --- Access (optional) ---
# Its own password and its own cookie. Cookies are scoped to a host and not to
# a port, so sharing one variable would let a session for one app unlock the
# other.
# SKINS_APP_PASSWORD=
# Optional separate signing secret. Without one, a random key is made on first
# login and kept in SKINS_DATA_DIR/session-secret; set this to use your own.
# SKINS_APP_SECRET=

# --- Storage ---
# Directory for the SQLite database and the Markdown copy of the inventory
# (default: ./data, resolved from apps/skins). Ignored under Docker Compose,
# where the data directory is always the /data volume.
# SKINS_DATA_DIR=./data
# The database file itself, when it should live somewhere other than SKINS_DATA_DIR.
# SKINS_DATABASE_FILE=./data/collectcollect-skins.db
# Every item is also written as a Markdown file under SKINS_DATA_DIR/collection.
# Its own switch: the card app's MARKDOWN_MIRROR has no effect here.
# SKINS_MARKDOWN_MIRROR=on

# --- Price sources ---
# Steam and Skinport need no key and are always on. Skinport returns its whole
# catalogue in one request; Steam answers about twenty times a minute, so a
# large inventory takes a while to price.
#
# CSFloat needs a key. It is also the only source that knows an item's float
# without inspecting it in game. https://csfloat.com/profile/developer
# CSFLOAT_API_KEY=

# A price you type in on an item overrides every source, on that item.

# --- Price history ---
# Re-price anything whose latest price is older than this many hours (checked
# hourly). 0 disables. A large inventory takes a while, which is fine here:
# it runs in the background and skips anything already fresh. Read once at
# start, so a change needs a restart.
# SKINS_AUTO_REFRESH_HOURS=24

# ===========================================================================
# Building
# ===========================================================================
# Set when building the Docker image: produces the self-contained server the
# image runs. `next start` does not use it, so a normal build leaves it unset.
# BUILD_STANDALONE=1
