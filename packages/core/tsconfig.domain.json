{
  // The domain engine (src/domain, the pages and components drawn from a spec),
  // its vitest suite and that suite's config, under every option of
  // tsconfig.json but one: noUncheckedIndexedAccess, which this code does not
  // pass yet. It came from a branch written before the rest of the package was
  // held to it. Once it does, these files move into tsconfig.json and this
  // file goes. The grading verdict, the outlook chart and the PriceCharting
  // client the domain apps share (src/grading.ts, src/components/
  // OutlookChart.tsx, src/pricing) already pass it and are checked by
  // tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/domain/**/*.ts",
    "src/pages/**/*.tsx",
    "src/components/domain/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
