{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // The domain engine and what came with it are checked by tsconfig.domain.json
  // until they pass noUncheckedIndexedAccess; nothing here imports them.
  "exclude": [
    "node_modules",
    "src/domain",
    "src/pages",
    "src/components/domain"
  ]
}
